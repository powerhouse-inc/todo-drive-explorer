{
  "name": "@powerhousedao/todo-demo-package",
  "version": "1.2.0",
  "license": "AGPL-3.0-only",
  "author": "powerhouse",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editors": {
      "types": "./dist/editors/index.d.ts",
      "default": "./dist/editors/index.js"
    },
    "./document-models": {
      "types": "./dist/document-models/index.d.ts",
      "default": "./dist/document-models/index.js"
    },
    "./subgraphs": {
      "types": "./dist/subgraphs/index.d.ts",
      "default": "./dist/subgraphs/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "tsc": "tsc",
    "lint": "eslint --config eslint.config.js --cache --cache-strategy content",
    "tailwind": "npx @tailwindcss/cli -i ./style.css -o ./dist/style.css",
    "build:lib": "npm run tsc -b && npm run tailwind",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "generate": "ph-cli generate",
    "connect": "ph-cli connect",
    "reactor": "ph-cli reactor",
    "service": "ph-cli service",
    "service-startup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-startup.sh",
    "service-unstartup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-unstartup.sh"
  },
  "dependencies": {
    "@powerhousedao/builder-tools": "dev",
    "@powerhousedao/common": "dev",
    "@powerhousedao/connect": "dev",
    "@powerhousedao/design-system": "dev",
    "@powerhousedao/document-engineering": "^1.0.2",
    "@powerhousedao/reactor-browser": "dev",
    "document-model": "dev",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@eslint/js": "^9.35.0",
    "@powerhousedao/codegen": "dev",
    "@powerhousedao/ph-cli": "dev",
    "@powerhousedao/reactor-api": "dev",
    "@powerhousedao/reactor-local": "dev",
    "@storybook/preview-api": "^8.6.14",
    "@tailwindcss/cli": "^4.0.15",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.19",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "document-drive": "dev",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "package-manager-detector": "^1.1.0",
    "pm2": "^5.4.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": ""
}